@@ -378,6 +378,22 @@ impl MapObject {
     /// wrong drifts `lastlook` so the `lastlook == stop` guard
     /// short-circuits before the sight check, and monsters that should wake
     /// never do — a demo-desync source.
+    /// doomMod hunter: always knows where a live player is (no sight check).
+    pub(crate) fn hunter_acquire(&mut self) -> bool {
+        if self.kind != MapObjKind::MT_HUNTER {
+            return false;
+        }
+        for i in 0..MAXPLAYERS {
+            if self.level().players_in_game()[i] && self.level().players()[i].status.health > 0 {
+                self.target = self.level_mut().players_mut()[i].mobj_mut().map(|m| m.thinker);
+                if self.target.is_some() {
+                    return true;
+                }
+            }
+        }
+        false
+    }
+
