+
+#[cfg(test)]
+mod frc_robot_respawn_tests {
+    //! doomMod: KitBot robots (zombie types) and the hunter respawn 10-30 s after
+    //! dying, regardless of skill or `-respawn`; other monsters still don't.
+    use crate::MapObjKind;
+    use crate::doom_def::TICRATE;
+    use crate::test_support::{TestLevel, rng_guard};
+
+    const X: i32 = 1056;
+    const Y: i32 = -3616;
+
+    fn live(level: &mut TestLevel, kind: MapObjKind) -> usize {
+        let (lvl, _, _) = level.parts_mut();
+        let mut n = 0;
+        lvl.thinkers.find_thinker_mut(|t| {
+            if t.is_mobj() && t.mobj().kind == kind && t.mobj().health > 0 {
+                n += 1;
+            }
+            false
+        });
+        n
+    }
+
+    /// Kill a freshly spawned `kind` and return the tic it came back on (if any).
+    fn respawn_tic(kind: MapObjKind, max_tics: u32) -> Option<u32> {
+        let mut level = TestLevel::load("E1M1");
+        let mobj = level.spawn(X, Y, kind);
+        mobj.spawnpoint.x = X as i16;
+        mobj.spawnpoint.y = Y as i16;
+        mobj.p_take_damage(None, None, 10_000);
+        assert_eq!(live(&mut level, kind), 0, "{kind:?} should be dead");
+        for tic in 1..=max_tics {
+            level.run_level_tics(1);
+            if live(&mut level, kind) > 0 {
+                return Some(tic);
+            }
+        }
+        None
+    }
+
+    #[test]
+    fn robots_respawn_between_10_and_30_seconds() {
+        let _g = rng_guard();
+        for kind in [
+            MapObjKind::MT_POSSESSED,
+            MapObjKind::MT_SHOTGUY,
+            MapObjKind::MT_CHAINGUY,
+            MapObjKind::MT_HUNTER,
+        ] {
+            let tic = respawn_tic(kind, 31 * TICRATE as u32)
+                .unwrap_or_else(|| panic!("{kind:?} did not respawn within 31 s"));
+            assert!(
+                tic >= 10 * TICRATE as u32,
+                "{kind:?} respawned too early: {tic} tics"
+            );
+        }
+    }
+
+    #[test]
+    fn other_monsters_stay_dead() {
+        let _g = rng_guard();
+        assert_eq!(respawn_tic(MapObjKind::MT_TROOP, 60 * TICRATE as u32), None);
+    }
+}
