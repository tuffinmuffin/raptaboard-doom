@@ -0,0 +1,64 @@
+//! Buffer backend — keeps the engine's CPU frame in memory for the caller to
+//! read, instead of showing it in a window. For embedding the engine where the
+//! host draws the pixels itself (a raptaboard plugin built for WebAssembly).
+//!
+//! Software-present only. The "window" is a size the caller sets.
+
+use pic_data::PixelFmt;
+
+use crate::backend::{Backend, RenderKind, SoftwarePresent};
+
+/// Buffer backend: the last presented frame and the size to render at.
+pub struct BufferBackend<P: PixelFmt> {
+    size: (u32, u32),
+    frame: Vec<P>,
+    frame_size: (u32, u32),
+    presented: u64,
+}
+
+impl<P: PixelFmt + Clone> BufferBackend<P> {
+    pub(crate) fn new(width: u32, height: u32) -> Self {
+        Self {
+            size: (width.max(1), height.max(1)),
+            frame: Vec::new(),
+            frame_size: (0, 0),
+            presented: 0,
+        }
+    }
+
+    /// The size to render at, as a window's would be.
+    pub fn set_size(&mut self, width: u32, height: u32) {
+        self.size = (width.max(1), height.max(1));
+    }
+
+    /// The last frame presented: its pixels (tight, `w * h`), `w` and `h`.
+    pub fn frame(&self) -> (&[P], u32, u32) {
+        (&self.frame, self.frame_size.0, self.frame_size.1)
+    }
+
+    /// How many frames have been presented.
+    pub fn presented(&self) -> u64 {
+        self.presented
+    }
+}
+
+impl<P: PixelFmt + Clone> Backend for BufferBackend<P> {
+    fn window_size(&self) -> (u32, u32) {
+        self.size
+    }
+
+    fn set_fullscreen(&mut self, _mode: u8) {}
+
+    fn supports(&self, kind: RenderKind) -> bool {
+        kind == RenderKind::Software
+    }
+}
+
+impl<P: PixelFmt + Clone> SoftwarePresent<P> for BufferBackend<P> {
+    fn present(&mut self, front: &[P], w: u32, h: u32) {
+        self.frame.clear();
+        self.frame.extend_from_slice(front);
+        self.frame_size = (w, h);
+        self.presented += 1;
+    }
+}
